# cppcoreguidelines-avoid-reference-coroutine-parameters is off: API handlers
# take RequestContext& and are always co_await-ed by the server, so the
# context outlives them (see Handler in src/lib/api/router.hpp).
Checks: '-*,
bugprone-*,
cppcoreguidelines-*,
misc-*,
modernize-*,
performance-*,
readability-*,
hicpp-*,
google-*,
cert-*,
-readability-magic-numbers,
-readability-implicit-bool-conversion,
-readability-identifier-length,
-modernize-use-trailing-return-type,
-modernize-use-nodiscard,
-cppcoreguidelines-pro-type-const-cast,
-cppcoreguidelines-avoid-magic-numbers,
-cppcoreguidelines-avoid-non-const-global-variables,
-cppcoreguidelines-special-member-functions,
-cppcoreguidelines-avoid-goto,
-cppcoreguidelines-avoid-do-while,
-cppcoreguidelines-owning-memory,
-bugprone-reserved-identifier,
-cert-err58-cpp,
-cppcoreguidelines-avoid-reference-coroutine-parameters,
'
CheckOptions:
  - key:             misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value:           '1'
  - key:             cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value:           '1'
  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: hicpp-special-member-functions.AllowSoleDefaultDtor
    value: true
  - key: bugprone-easily-swappable-parameters.MinimumLength
    value: 3        # only warn for 3+ adjacent same-typed params

