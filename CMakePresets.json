{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/",
      "installDir": "${sourceDir}/install/",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "x64-debug-linux",
      "displayName": "x64 Debug Linux",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x64-release-linux",
      "displayName": "x64 Release Linux",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "x64-debug-linux-BT",
      "displayName": "x64 Debug Linux (build-tree export) (not impl)",
      "inherits": "x64-debug-linux",
      "cacheVariables": { "EXPORT_BUILD_TREE": "ON" }
    },
    {
      "name": "x64-release-linux-BT",
      "displayName": "x64 Release Linux (build-tree export) (not impl)",
      "inherits": "x64-release-linux",
      "cacheVariables": { "EXPORT_BUILD_TREE": "ON" }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/",
      "installDir": "${sourceDir}/install/",
      "architecture": { "value": "x64", "strategy": "external" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "WITH_LDAP": "OFF",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "x64-debug-windows",
      "displayName": "x64 Debug Windows",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "x64-release-windows",
      "displayName": "x64 Release Windows",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "x64-debug-windows-BT",
      "displayName": "x64 Debug Windows (build-tree export) (not impl)",
      "inherits": "x64-debug-windows",
      "cacheVariables": { "EXPORT_BUILD_TREE": "ON" }
    },
    {
      "name": "x64-release-windows-BT",
      "displayName": "x64 Release Windows (build-tree export) (not impl)",
      "inherits": "x64-release-windows",
      "cacheVariables": { "EXPORT_BUILD_TREE": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug-linux", "configurePreset": "x64-debug-linux" },
    { "name": "x64-release-linux", "configurePreset": "x64-release-linux" },
    { "name": "x64-debug-linux-BT", "configurePreset": "x64-debug-linux-BT" },
    { "name": "x64-release-linux-BT", "configurePreset": "x64-release-linux-BT" },
    { "name": "x64-debug-windows", "configurePreset": "x64-debug-windows" },
    { "name": "x64-release-windows", "configurePreset": "x64-release-windows" },
    { "name": "x64-debug-windows-BT", "configurePreset": "x64-debug-windows-BT" },
    { "name": "x64-release-windows-BT", "configurePreset": "x64-release-windows-BT" }
  ],
  "testPresets": [
    { "name": "x64-debug-linux", "configurePreset": "x64-debug-linux", "output": {"outputOnFailure": true} },
    { "name": "x64-debug-windows", "configurePreset": "x64-debug-windows", "output": {"outputOnFailure": true} }
  ]
}
