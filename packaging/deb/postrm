#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
fi
# The confide user and /var/lib/confide (transferred files) are kept.
if [ "$1" = purge ]; then
  for path in /etc/confide/server.toml /etc/confide; do
    if dpkg-statoverride --list "$path" >/dev/null; then
      dpkg-statoverride --remove "$path"
    fi
  done
fi

exit 0
