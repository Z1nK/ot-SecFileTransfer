# Same unit for Ubuntu and EL8. EL8 has systemd 239, so nothing newer is used.
# Local changes: `systemctl edit confide-server`, not this file.
[Unit]
Description=Confide secure file transfer server
Documentation=https://github.com/Z1nK/ot-SecFileTransfer
# Peer and bind host names are resolved at startup.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=confide
Group=confide
ExecStart=/usr/bin/confide-server /etc/confide/server.toml
Restart=on-failure
RestartSec=5

# /var/lib/confide and /var/log/confide (storage.root and log.dir in
# server.toml), created and owned by the confide user. Another storage.root
# or log.dir needs ReadWritePaths= in an override.
StateDirectory=confide
LogsDirectory=confide
StateDirectoryMode=0750
LogsDirectoryMode=0750

# A port below 1024 needs:
# AmbientCapabilities=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0027

[Install]
WantedBy=multi-user.target
